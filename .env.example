# Afe docker-compose settings. Copy to .env and edit:  cp .env.example .env
# Full reference: docs/self-hosting/configuration.md
# .env is read by docker compose and passed to the Afe containers. Never commit it.

# --- Required -----------------------------------------------------------------
# Password for the bundled PostgreSQL. Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Image --------------------------------------------------------------------
# Pin a released version (e.g. 0.1.0) instead of latest, and upgrade deliberately
# (docs/self-hosting/operations.md#upgrades).
AFE_VERSION=latest
# AFE_IMAGE=ghcr.io/theafeai/afe

# --- Server -------------------------------------------------------------------
# Host port for the UI/API/webhooks; always bound to 127.0.0.1 by docker-compose.yml.
AFE_HTTP_PORT=8080
# trace | debug | info | warn | error | fatal | silent
AFE_LOG_LEVEL=info

# --- Event retention (docs/self-hosting/configuration.md#event-retention) ------
# Days events (and their raw payloads) are kept, by when they happened. 1 to 60
# (60 is the open-source maximum; a larger value stops Afe from starting).
AFE_EVENT_RETENTION_DAYS=30

# --- Outbound network policy (docs/security/rules.md R6) ------------------------
# Set to true if ArgoCD (or another target) is on a private network.
AFE_ALLOW_PRIVATE_NETWORK_TARGETS=false
# Lab setups only: allow plain http to private targets.
AFE_ALLOW_INSECURE_HTTP_TARGETS=false

# --- Encryption key -------------------------------------------------------------
# docker-compose.yml provides the key as a Docker secret from
# ./secrets/afe_encryption_key (AFE_ENCRYPTION_KEY_FILE). Do NOT also set
# AFE_ENCRYPTION_KEY here. For rotation (docs/self-hosting/secrets.md):
# AFE_ENCRYPTION_ACTIVE_KEY_ID=

# --- Authentication (docs/self-hosting/configuration.md#authentication) ----------
# docker-compose.yml provides the admin token as a Docker secret from
# ./secrets/afe_admin_token (AFE_ADMIN_TOKEN_FILE). Do NOT also set
# AFE_ADMIN_TOKEN here. Optional read-only token for viewers (>= 32 characters):
# AFE_VIEWER_TOKEN=
# Optional fixed key for UI session cookies (default: derived from the tokens):
# AFE_SESSION_SECRET=
# AFE_SESSION_TTL=12h

# --- Connectors -----------------------------------------------------------------
# GitHub App, ArgoCD and Vercel settings are being finalised (AFE-6, AFE-9,
# AFE-11); see docs/self-hosting/credentials/.

# Personal GitHub account linking (separate from installing the tenant GitHub App).
# Callback: ${AFE_PUBLIC_URL}/api/profile/tools/github/callback
# AFE_USER_GITHUB_CLIENT_ID=
# AFE_USER_GITHUB_CLIENT_SECRET_FILE=/run/secrets/afe_user_github_client_secret

# Personal Vercel account linking (a dedicated integration with read-only scopes).
# Callback: ${AFE_PUBLIC_URL}/api/profile/tools/vercel/callback
# AFE_USER_VERCEL_CLIENT_ID=
# AFE_USER_VERCEL_CLIENT_SECRET_FILE=/run/secrets/afe_user_vercel_client_secret
# AFE_USER_VERCEL_INTEGRATION_SLUG=

# Optional transactional email (invitations and access-credential resets).
# AFE_PUBLIC_URL must be the HTTPS origin of Afe. Run both server and worker
# with these settings and the same AFE_ENCRYPTION_KEY.
# AFE_SMTP_HOST=smtp.example.com
# AFE_SMTP_PORT=587
# AFE_SMTP_SECURE=false
# AFE_SMTP_FROM=afe@example.com
# AFE_SMTP_USERNAME=afe
# AFE_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# STARTTLS is required by default. Port 465 uses AFE_SMTP_SECURE=true.
# AFE_SMTP_ALLOW_PLAINTEXT=false
